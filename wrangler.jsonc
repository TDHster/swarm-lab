// Cloudflare Worker "swarm-lab" (swarm-lab.tdhster.workers.dev): static files only, no server code.
// `npx wrangler deploy` first runs build.command (make-site.sh builds site/), then uploads site/.
// The same command works locally and in Cloudflare Workers Builds on push to main.
{
  "name": "swarm-lab",
  "compatibility_date": "2026-10-01",
  "build": { "command": "./make-site.sh" },
  "assets": { "directory": "./site" }
}
